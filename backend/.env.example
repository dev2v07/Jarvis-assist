# Copy to backend/dev.env for local development and fill only what you use.
JARVIS_API_PORT=8000
HEL_LLM_PROVIDER=ollama
HEL_OLLAMA_BASE_URL=http://127.0.0.1:11434
HEL_OLLAMA_MODEL=phi3:latest
HEL_OPENAI_BASE_URL=https://api.openai.com/v1
HEL_OPENAI_MODEL=gpt-4o-mini
HEL_OPENAI_API_KEY=

# Optional DeepSeek OpenAI-compatible provider
HEL_DEEPSEEK_BASE_URL=https://api.deepseek.com
HEL_DEEPSEEK_MODEL=deepseek-flash
HEL_DEEPSEEK_API_KEY=
PICOVOICE_TOKEN=
OPENWEATHER_API_KEY=
