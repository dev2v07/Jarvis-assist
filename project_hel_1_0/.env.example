# Copy to .env and fill the values you need.
HEL_ENV=development
HEL_LOG_LEVEL=INFO
HEL_API_HOST=127.0.0.1
HEL_API_PORT=8000
HEL_LLM_PROVIDER=stub
HEL_OLLAMA_BASE_URL=http://127.0.0.1:11434
HEL_OLLAMA_MODEL=qwen2.5:7b-q4_K_M
HEL_OPENAI_BASE_URL=https://api.openai.com/v1
HEL_OPENAI_MODEL=gpt-4o-mini
HEL_OPENAI_API_KEY=
HEL_LLM_REQUEST_TIMEOUT=45
HEL_LLM_MAX_RETRIES=2
HEL_NETWORK_REQUEST_TIMEOUT=20
HEL_NETWORK_MAX_RETRIES=2
HEL_RETRY_BACKOFF_SECONDS=1.5
# Optional overrides
# HEL_WORKSPACE_DIR=C:\Users\YourName\hel_data
# HEL_DATA_HOME=C:\Users\YourName\AppData\Roaming\ProjectHel\data
# HEL_LOG_DIR=C:\Users\YourName\AppData\Roaming\ProjectHel\logs
